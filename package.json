{
  "name": "dsh-weixin-clawbot",
  "version": "0.1.0",
  "description": "DeepSeek Harness 微信远程控制插件：用微信消息远程对话/控制运行中的 DSH agent",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "examples"
  ],
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:host": "tsc -p tsconfig.build.json",
    "build:client": "node scripts/build-client.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "wechat",
    "weixin",
    "微信",
    "wechaty",
    "cordis"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "@juzi/file-box": "^1.8.2",
    "@juzi/wechaty": "^1.0.164",
    "@juzi/wechaty-puppet-service": "^1.0.124",
    "qrcode": "^1.5.4",
    "wechaty-puppet-wechat4u": "^1.14.14"
  },
  "optionalDependencies": {
    "wechaty-puppet-official-account": "^1.10.14",
    "wechaty-puppet-wcferry": "^0.1.7",
    "wechaty-puppet-wechat": "^1.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-default-model": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiixiixixi/dsh-weixin-clawbot.git"
  },
  "author": "weixi li"
}
